#!/usr/local/bin/sbcl --script 
; use this for making objects, mainly placeholder currently, current theory is modular objects, each object will be 
; formed via the formation of the 3 axis variables
(load "/home/user/Downloads/3-lisp.cl")
(setq xaxis (make-array '(20 20) :initial-element 0))
(setq yaxis (make-array '(20 20) :initial-element 0))
(setq zaxis (make-array '(20 20) :initial-element 0))
(setq xextreme (make-array '(20 20) :initial-element 0))
(setq yextreme (make-array '(20 20) :initial-element 0))
(setq zextreme (make-array '(20 20) :initial-element 0))
(setq corner 0)
(setq thick4 0)
(defvar currentshape 0)
; simple shapes

(defun cubewhole (shapename)
	(defparameter usedvar (list "aaxis" "corner" "end" shapename))
	(dotimes (i 4)
		(if (<= i 1)

			(setf (aref xaxis 0   (* i 19) ) 15)
			(setf  (aref xaxis 19 (- (* i 19) 38)) 15)))
	(dotimes (i 4)
		(if (<= i 1)

			(setf (aref yaxis 0   (* i 19) ) 15)
			(setf  (aref yaxis 19 (- (* i 19) 38)) 15)))
	(dotimes (i 4)
		(if (<= i 1)

			(setf (aref zaxis 0   (* i 19) ) 1)
			(setf  (aref zaxis 19 (- (* i 19) 38)) 15)))
	(setq corner 1))
(defun tube (shapename)
	(defparameter *words* (list "xaxis" "xextreme" "thickness" "end" shapename))
	(dotimes (i 4)
		(if (<= i 1)

			(setf (aref xaxis 9   (* i 19) ) 14)
			(setf  (aref xaxis (- (* i 19) 38) 9) 14)))
	(dotimes (i 4)
		(if (<= i 1)

			(setf (aref xextreme 9   (* i 19) ) 14)
			(setf  (aref xextreme (- (* i 19) 38) 9) 14)))
	(setq thickness 2))
	




